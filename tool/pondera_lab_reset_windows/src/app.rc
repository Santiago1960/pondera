    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Bitgenial\0"
      VALUE "FileDescription", "Pondera Lab Reset (uso interno)\0"
      VALUE "FileVersion", "1.1.0\0"
      VALUE "InternalName", "pondera_lab_reset\0"
      VALUE "OriginalFilename", "pondera_lab_reset.exe\0"
      VALUE "ProductName", "Pondera Lab Reset\0"
      VALUE "ProductVersion", "1.1.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
